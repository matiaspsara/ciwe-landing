---
import Layout from '../layouts/Layout.astro';
import { postres } from '../data/pasteleria.js';
---

<Layout title="Pastelería · Ciwe" description="Carta de pastelería artesanal de Ciwe. Postres y creaciones especiales por porción.">

  <!-- Sticky back nav -->
  <header class="bg-brand-green-dark text-white sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-white/60 hover:text-white transition-colors text-xs font-bold uppercase tracking-widest">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Volver al sitio
      </a>
      <img src="/logo.png" alt="Ciwe" class="h-7 brightness-0 invert" />
      <span class="text-xs font-bold uppercase tracking-widest text-white/40 hidden sm:block">Heladería Artesanal</span>
    </div>
  </header>

  <main class="bg-brand-cream">

    <!-- Hero banner -->
    <div class="bg-brand-green-dark relative overflow-hidden py-16 md:py-20 text-center">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none">
        <span class="font-heading font-bold text-[18rem] leading-none text-white/[0.03]">1979</span>
      </div>
      <p class="relative text-xs font-bold uppercase tracking-[0.3em] text-brand-beige/70 mb-3">Heladería Ciwe</p>
      <h1 class="relative font-heading text-4xl md:text-6xl text-white leading-tight">
        Pastelería
      </h1>
      <div class="relative mt-5 w-16 h-0.5 bg-brand-beige/40 mx-auto"></div>
      <p class="relative mt-4 text-brand-cream/50 text-sm">Postres artesanales · Porciones individuales</p>
    </div>

    <!-- Postres -->
    <section id="postres" class="py-12 px-6">
      <div class="max-w-6xl mx-auto">

        <div class="mb-8">
          <h2 class="font-heading text-3xl md:text-4xl text-brand-green-dark">Postres</h2>
          <p class="text-sm text-brand-taupe mt-2">Porciones individuales · Disponibles todos los días</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {postres.map((postre) => (
            <article class="group rounded-2xl overflow-hidden border border-brand-cream-dark bg-white flex flex-col shadow-sm">
              <div class="relative overflow-hidden aspect-square">
                {postre.photo ? (
                  <img
                    src={postre.photo}
                    alt={postre.name}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="w-full h-full"
                    style={`background: ${postre.gradient};`}
                  />
                )}
                {postre.tags?.map((tag) => (
                  <span class="absolute top-3 left-3 bg-brand-beige text-brand-green-dark text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="p-4 flex flex-col gap-1.5 flex-1">
                <h3 class="font-heading text-base leading-snug text-brand-green-dark">
                  {postre.name}
                </h3>
                <p class="text-xs text-brand-taupe leading-relaxed">{postre.description}</p>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- Footer note -->
    <p class="text-center text-xs text-brand-taupe/50 italic pb-12 px-6">
      La disponibilidad puede variar según el día · Consultá en el local · 011 4664-6003
    </p>

  </main>

</Layout>
