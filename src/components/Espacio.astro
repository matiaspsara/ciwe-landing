---
const photos = [
  { src: '/photos/Local-Fachada-Esquina-Vista-Amplia.jpg', alt: 'Fachada de Ciwe en la esquina' },
  { src: '/photos/Local-Interior-Mostrador-Tortas.jpg',    alt: 'Mostrador interior de Ciwe' },
  { src: '/photos/Local-Mural-Patio-Exterior.png',         alt: 'Mural en el patio exterior de Ciwe' },
  { src: '/photos/Local-Vereda-Mesas-Exteriores.jpg',      alt: 'Mesas en la vereda de Ciwe' },
];
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">

    <div data-animate class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-green mb-3">Vení a visitarnos</p>
      <h2 class="font-heading text-5xl md:text-6xl text-brand-green-dark">Nuestro Espacio</h2>
      <div class="mt-4 w-16 h-0.5 bg-brand-green mx-auto"></div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {photos.map((photo, i) => (
        <div data-animate style={`--delay: ${i * 80}ms`} class="aspect-square rounded-2xl overflow-hidden group">
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      ))}
    </div>

  </div>
</section>
