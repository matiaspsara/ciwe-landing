---
import { tortasHeladas } from '../data/pasteleria.js';

const hero = tortasHeladas.find(t => t.name === 'Selva Negra');
const carousel = tortasHeladas.filter(t => t.name !== 'Selva Negra');
---

<section id="tortas-heladas" class="bg-brand-cream-dark">

  <!-- Billboard hero (Selva Negra) -->
  <div data-animate class="relative w-full h-[400px] md:h-[500px] overflow-hidden">
    <img
      src={hero.photo}
      alt="Tortas Heladas Ciwe"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/72 via-black/40 to-transparent"></div>
    <div class="absolute inset-0 flex flex-col justify-center px-8 md:px-16">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-brand-beige/75 mb-3">Heladería Ciwe</p>
      <h2 class="font-heading text-5xl md:text-6xl text-white leading-tight mb-3">
        Tortas<br />Heladas
      </h2>
      <div class="w-16 h-0.5 bg-white/40 mb-5"></div>
      <p class="text-white/70 text-base leading-relaxed max-w-xs md:max-w-sm mb-6">
        Hechas con nuestro helado artesanal para cada celebración. Disponibles en tamaños familiares y para grupos.
      </p>
      <p class="text-xs font-bold uppercase tracking-widest text-white/50">
        Pedidos con anticipación · Consultar disponibilidad
      </p>
    </div>
  </div>

  <!-- Carousel -->
  <div class="py-8 md:py-10">
    <div class="max-w-7xl mx-auto relative px-6 md:px-10">

      <!-- Prev arrow (desktop) -->
      <button
        id="tortas-prev"
        class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-brand-cream-dark shadow-sm items-center justify-center text-brand-green hover:bg-brand-cream transition-colors"
        aria-label="Anterior"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Track -->
      <div
        id="tortas-track"
        class="flex gap-3 overflow-x-auto overflow-y-hidden scrollbar-hide scroll-smooth snap-x snap-mandatory"
        style="overscroll-behavior-x: contain;"
      >
        {carousel.map((torta, i) => (
          <div
            data-animate
            style={`--delay: ${i * 60}ms`}
            class="flex-none w-[calc(50%-6px)] md:w-[calc(25%-9px)] group relative rounded-2xl overflow-hidden aspect-square bg-brand-cream snap-start"
          >
            <img
              src={torta.photo}
              alt={torta.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/65 via-black/25 to-transparent px-4 py-4 pt-10">
              <p class="text-white font-heading font-bold text-sm leading-tight">{torta.name}</p>
              {torta.sizes && (
                <p class="text-[11px] text-white/65 font-sans mt-0.5">{torta.sizes}</p>
              )}
            </div>
            {torta.badges?.map(badge => (
              <span class="absolute top-3 left-3 bg-brand-green text-white text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full">
                {badge.text}
              </span>
            ))}
          </div>
        ))}
      </div>

      <!-- Next arrow (desktop) -->
      <button
        id="tortas-next"
        class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-brand-cream-dark shadow-sm items-center justify-center text-brand-green hover:bg-brand-cream transition-colors"
        aria-label="Siguiente"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

    </div>
  </div>

</section>

<script>
  const track = document.getElementById('tortas-track') as HTMLElement;
  const prev  = document.getElementById('tortas-prev') as HTMLButtonElement;
  const next  = document.getElementById('tortas-next') as HTMLButtonElement;

  const scrollAmount = () => {
    const card = track?.firstElementChild as HTMLElement;
    return card ? card.offsetWidth + 12 : 0;
  };

  prev?.addEventListener('click', () => track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }));
  next?.addEventListener('click', () => track.scrollBy({ left: scrollAmount(), behavior: 'smooth' }));
</script>
