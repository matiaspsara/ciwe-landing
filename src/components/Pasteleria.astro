---
const photos = [
  { src: '/photos/Mesa-Desayuno-Cafe-Postres-Variados.jpg', alt: 'Mesa de desayuno con café y postres', tall: true },
  { src: '/photos/Torta-RedVelvet-Capas-Closeup.jpg',       alt: 'Torta Red Velvet por capas' },
  { src: '/photos/Cheesecake-Pistacho-Almendras.jpg',       alt: 'Cheesecake de pistacho con almendras' },
  { src: '/photos/Torta-Oreo-Porcion-Servida.jpg',          alt: 'Porción de torta Oreo' },
  { src: '/photos/Torta-Zanahoria-Porcion-Cuadrada.jpg',    alt: 'Porción de torta de zanahoria' },
];
---

<section id="pasteleria" class="py-24 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

      <!-- Photo grid -->
      <div class="grid grid-cols-3 grid-rows-2 gap-3 h-[480px] order-2 md:order-1">
        <!-- Tall left image -->
        <div data-animate class="row-span-2 rounded-2xl overflow-hidden">
          <img
            src={photos[0].src}
            alt={photos[0].alt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- 2x2 grid on the right -->
        {photos.slice(1).map((photo, i) => (
          <div data-animate style={`--delay: ${(i + 1) * 80}ms`} class="rounded-2xl overflow-hidden">
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- Text -->
      <div data-animate class="flex flex-col gap-6 order-1 md:order-2">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-green">Pastelería</p>
        <h2 class="font-heading text-5xl md:text-6xl text-brand-green-dark leading-tight">
          El dulce arte<br /><em>de la pastelería</em>
        </h2>
        <div class="w-16 h-0.5 bg-brand-green"></div>
        <p class="text-brand-taupe text-base leading-relaxed max-w-md">
          Nuestra pastelería artesanal nace de la misma dedicación y los mismos ingredientes de calidad que nuestros helados. Tortas, postres y creaciones especiales elaboradas con amor.
        </p>
        <p class="text-brand-taupe/50 text-sm italic">
          [Próximamente: carta de pastelería completa]
        </p>
      </div>

    </div>
  </div>
</section>
