---
const featured = [
  { src: '/photos/pasteleria/Cheesecake-Italiano.webp',  name: 'Cheesecake Italiano', tag: null },
  { src: '/photos/pasteleria/LemonPie.webp',             name: 'Lemon Pie',            tag: null },
  { src: '/photos/pasteleria/BrowniePatagonico.webp',    name: 'Brownie Patagónico',   tag: null },
  { src: '/photos/pasteleria/Chocotorta-Porcion.webp',   name: 'Chocotorta',           tag: null },
];
---

<section id="pasteleria" class="py-24 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-[5fr_7fr] gap-16 items-center">

      <!-- Text -->
      <div data-animate class="flex flex-col gap-6">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-green">Pastelería</p>
        <h2 class="font-heading text-5xl md:text-6xl text-brand-green-dark leading-tight">
          El dulce arte<br /><em>de la pastelería</em>
        </h2>
        <div class="w-16 h-0.5 bg-brand-green"></div>
        <p class="text-brand-taupe text-base leading-relaxed">
          Postres artesanales por porción para el día a día. Todo elaborado con los mismos ingredientes de calidad que nuestros helados.
        </p>
        <div class="mt-2">
          <a
            href="/pasteleria"
            class="inline-flex items-center gap-2 px-7 py-3.5 border-2 border-brand-green text-brand-green font-heading font-bold text-sm uppercase tracking-wider rounded-full hover:bg-brand-green hover:text-white transition-colors"
          >
            Ver carta completa
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Product cards -->
      <div class="grid grid-cols-2 gap-3">
        {featured.map((item, i) => (
          <div
            data-animate
            style={`--delay: ${i * 80}ms`}
            class="group relative rounded-2xl overflow-hidden aspect-square bg-brand-cream-dark"
          >
            <img
              src={item.src}
              alt={item.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 via-black/20 to-transparent px-4 py-4 pt-10">
              <p class="text-white font-heading font-bold text-sm leading-tight">{item.name}</p>
              {item.tag && (
                <span class="text-[11px] text-white/75 font-sans mt-0.5 block">{item.tag}</span>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
