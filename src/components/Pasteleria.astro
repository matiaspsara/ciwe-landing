---
const photos = [
  { src: '/photos/Mesa-Desayuno-Cafe-Postres-Variados.webp', alt: 'Mesa de desayuno con café y postres', tall: true },
  { src: '/photos/Torta-RedVelvet-Capas-Closeup.webp',       alt: 'Torta Red Velvet por capas' },
  { src: '/photos/Cheesecake-Pistacho-Almendras.webp',       alt: 'Cheesecake italiano con pistacho' },
  { src: '/photos/pasteleria/LemonPie.webp',                 alt: 'Lemon Pie artesanal' },
  { src: '/photos/pasteleria/BrowniePatagonico.webp',        alt: 'Brownie Patagónico' },
];
---

<section id="pasteleria" class="py-24 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

      <!-- Photo grid -->
      <div class="grid grid-cols-3 grid-rows-2 gap-3 h-[480px] order-2 md:order-1">
        <!-- Tall left image -->
        <div data-animate class="row-span-2 rounded-2xl overflow-hidden">
          <img
            src={photos[0].src}
            alt={photos[0].alt}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- 2x2 grid on the right -->
        {photos.slice(1).map((photo, i) => (
          <div data-animate style={`--delay: ${(i + 1) * 80}ms`} class="rounded-2xl overflow-hidden">
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- Text -->
      <div data-animate class="flex flex-col gap-6 order-1 md:order-2">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-green">Pastelería</p>
        <h2 class="font-heading text-5xl md:text-6xl text-brand-green-dark leading-tight">
          El dulce arte<br /><em>de la pastelería</em>
        </h2>
        <div class="w-16 h-0.5 bg-brand-green"></div>
        <p class="text-brand-taupe text-base leading-relaxed max-w-md">
          Desde tortas heladas para celebrar hasta postres por porción para el día a día. Todo elaborado con los mismos ingredientes de calidad que nuestros helados.
        </p>
        <div class="flex flex-wrap gap-4 text-sm text-brand-taupe">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-green inline-block"></span>
            Tortas heladas para celebraciones
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-green inline-block"></span>
            Postres artesanales por porción
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-green inline-block"></span>
            Opciones sin TACC disponibles
          </span>
        </div>
        <div class="mt-2">
          <a
            href="/pasteleria"
            class="inline-flex items-center gap-2 px-7 py-3.5 border-2 border-brand-green text-brand-green font-heading font-bold text-sm uppercase tracking-wider rounded-full hover:bg-brand-green hover:text-white transition-colors"
          >
            Ver carta completa
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
