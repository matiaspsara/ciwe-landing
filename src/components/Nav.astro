---
const links = [
  { href: '#helados', label: 'Helados' },
  { href: '#pasteleria', label: 'Pastelería' },
  { href: '#historia', label: 'Historia' },
  { href: '#novedades', label: 'Novedades' },
  { href: '#chamote', label: 'Chamote' },
  { href: '#contacto', label: 'Contacto' },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  role="navigation"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#" class="flex-shrink-0">
      <img id="nav-logo" src="/logo.png" alt="Ciwe" class="h-8 w-auto transition-all duration-300 brightness-0 invert" />
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            data-nav-link
            class="text-sm font-bold uppercase tracking-widest text-white hover:text-white/70 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer"
      aria-label="Abrir menú"
    >
      <span class="block w-6 h-0.5 bg-white transition-all" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-white transition-all" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-white transition-all" id="bar3"></span>
    </button>
  </div>

  <!-- Mobile menu (always cream bg) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-brand-cream border-t border-brand-cream-dark px-6 pb-6"
  >
    <ul class="flex flex-col gap-4 pt-4">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm font-bold uppercase tracking-widest text-brand-green"
            data-mobile-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav   = document.getElementById('main-nav')!;
  const logo  = document.getElementById('nav-logo')!;
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const bars  = [
    document.getElementById('bar1')!,
    document.getElementById('bar2')!,
    document.getElementById('bar3')!,
  ];

  function setScrolled(scrolled: boolean) {
    if (scrolled) {
      nav.classList.add('bg-brand-cream/95', 'backdrop-blur-md', 'border-b', 'border-brand-cream-dark', 'shadow-sm');
      logo.classList.remove('brightness-0', 'invert');
      links.forEach(l => { l.classList.replace('text-white', 'text-brand-green'); l.classList.replace('hover:text-white/70', 'hover:text-brand-green-dark'); });
      bars.forEach(b => b.classList.replace('bg-white', 'bg-brand-green'));
    } else {
      nav.classList.remove('bg-brand-cream/95', 'backdrop-blur-md', 'border-b', 'border-brand-cream-dark', 'shadow-sm');
      logo.classList.add('brightness-0', 'invert');
      links.forEach(l => { l.classList.replace('text-brand-green', 'text-white'); l.classList.replace('hover:text-brand-green-dark', 'hover:text-white/70'); });
      bars.forEach(b => b.classList.replace('bg-brand-green', 'bg-white'));
    }
  }

  window.addEventListener('scroll', () => setScrolled(window.scrollY > 60), { passive: true });
  setScrolled(window.scrollY > 60);

  // Hamburger toggle
  const toggle = document.getElementById('nav-toggle')!;
  const menu   = document.getElementById('mobile-menu')!;

  toggle.addEventListener('click', () => {
    const open = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', open);
    bars[0].classList.toggle('rotate-45', !open);
    bars[0].classList.toggle('translate-y-2', !open);
    bars[1].classList.toggle('opacity-0', !open);
    bars[2].classList.toggle('-rotate-45', !open);
    bars[2].classList.toggle('-translate-y-2', !open);
  });

  document.querySelectorAll('[data-mobile-link]').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      bars[0].classList.remove('rotate-45', 'translate-y-2');
      bars[1].classList.remove('opacity-0');
      bars[2].classList.remove('-rotate-45', '-translate-y-2');
    });
  });
</script>
