---
---

<section id="chamote" class="py-24 bg-brand-cream">
  <div class="max-w-3xl mx-auto px-6 text-center flex flex-col items-center gap-8">

    <!-- Coming soon badge -->
    <span class="text-xs font-black uppercase tracking-[0.25em] text-brand-green border-2 border-brand-green rounded-full px-5 py-2">
      Próximamente
    </span>

    <!-- Chamote logo -->
    <img
      src="/logoChamoteCiwe.png"
      alt="Ciwe en Chamote"
      class="w-48 md:w-64 opacity-80"
    />

    <h2 class="font-heading text-4xl md:text-5xl text-brand-green-dark">
      Ciwe en Chamote
    </h2>

    <p class="text-brand-taupe text-base leading-relaxed max-w-md">
      Pronto vamos a llevar nuestros helados artesanales hasta Chamote. Seguinos en redes para ser el primero en enterarte cuándo arrancamos.
    </p>

    <!-- Divider with logo -->
    <div class="flex items-center gap-4 w-full max-w-xs">
      <div class="flex-1 h-px bg-brand-cream-dark"></div>
      <img src="/logo.png" alt="" class="w-8 opacity-30" aria-hidden="true" />
      <div class="flex-1 h-px bg-brand-cream-dark"></div>
    </div>

    <p class="text-sm text-brand-taupe/70 italic">
      Carrito heladero · En preparación
    </p>

  </div>
</section>
