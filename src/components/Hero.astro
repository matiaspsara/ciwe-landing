---
const slides = [
  {
    src:      '/photos/Local-Fachada-Esquina-Vista-Amplia.jpg',
    alt:      'Fachada de Ciwe',
    headline: 'El sabor que nos define, desde 1979.',
    subtext:  'Helados artesanales elaborados con recetas propias y los mejores ingredientes de la región.',
    cta:      'Ver Sabores',
    href:     '#helados',
  },
  {
    src:      '/photos/Helado-Vasito-Chocolate-Crema.jpg',
    alt:      'Vasito de helado de chocolate y crema Ciwe',
    headline: 'Más de 80 sabores únicos esta temporada.',
    subtext:  'Chocolates, cremas, frutas y mucho más. Descubrí las nuevas creaciones de la temporada 2025/26.',
    cta:      'Ver Novedades',
    href:     '#novedades',
  },
  {
    src:      '/photos/Local-Vereda-Mesas-Exteriores.jpg',
    alt:      'Mesas exteriores de Ciwe',
    headline: 'Un espacio para disfrutar.',
    subtext:  'Vení a compartir un momento especial con quienes más querés, en el corazón del barrio.',
    cta:      'Nuestro espacio',
    href:     '#contacto',
  },
];
---

<section data-hero class="relative h-screen min-h-[600px] overflow-hidden">

  <!-- Slides -->
  {slides.map((slide, i) => (
    <div
      data-hero-slide={i}
      class={`absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
    >
      <!-- Background image -->
      <img
        src={slide.src}
        alt={slide.alt}
        class="absolute inset-0 w-full h-full object-cover"
        loading={i === 0 ? 'eager' : 'lazy'}
      />
      <!-- Gradient overlay: dark left → transparent right -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-black/10"></div>
      <!-- Bottom vignette for dots legibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

      <!-- Content -->
      <div class="absolute inset-0 flex items-center">
        <div class="w-full max-w-7xl mx-auto px-8 md:px-12 pt-16">
          <div class="max-w-xl flex flex-col gap-5">
            <h1 class="font-heading font-bold text-white text-3xl md:text-5xl lg:text-6xl leading-tight">
              {slide.headline}
            </h1>
            <p class="text-white/80 text-base md:text-lg leading-relaxed max-w-md">
              {slide.subtext}
            </p>
            <div class="mt-2">
              <a
                href={slide.href}
                class="inline-block px-8 py-4 bg-white text-brand-green-dark font-heading font-bold text-sm uppercase tracking-wider rounded-full hover:bg-brand-cream transition-colors shadow-lg"
              >
                {slide.cta}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Left arrow (desktop only) -->
  <button
    data-hero-prev
    aria-label="Slide anterior"
    class="hidden md:flex absolute left-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/15 border border-white/30 backdrop-blur-sm items-center justify-center text-white hover:bg-white/30 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Right arrow (desktop only) -->
  <button
    data-hero-next
    aria-label="Slide siguiente"
    class="hidden md:flex absolute right-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/15 border border-white/30 backdrop-blur-sm items-center justify-center text-white hover:bg-white/30 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Dots -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2.5">
    {slides.map((_, i) => (
      <button
        data-hero-dot={i}
        aria-label={`Ir al slide ${i + 1}`}
        class={`h-2 rounded-full transition-all duration-400 ${i === 0 ? 'w-7 bg-white' : 'w-2 bg-white/45'}`}
      />
    ))}
  </div>

</section>

<script>
  const slides  = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
  const dots    = document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
  const btnPrev = document.querySelector<HTMLButtonElement>('[data-hero-prev]');
  const btnNext = document.querySelector<HTMLButtonElement>('[data-hero-next]');
  let current   = 0;

  function goTo(n: number) {
    slides[current].classList.replace('opacity-100', 'opacity-0');
    slides[current].classList.replace('z-10', 'z-0');
    dots[current].classList.remove('w-7', 'bg-white');
    dots[current].classList.add('w-2', 'bg-white/45');

    current = (n + slides.length) % slides.length;

    slides[current].classList.replace('opacity-0', 'opacity-100');
    slides[current].classList.replace('z-0', 'z-10');
    dots[current].classList.remove('w-2', 'bg-white/45');
    dots[current].classList.add('w-7', 'bg-white');
  }

  btnPrev?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
  btnNext?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
  dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); resetTimer(); }));

  let timer = setInterval(() => goTo(current + 1), 5000);
  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 5000);
  }

  // Touch swipe (mobile)
  let touchStartX = 0;
  const section = document.querySelector<HTMLElement>('section[data-hero]')!;
  section.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  section.addEventListener('touchend', e => {
    const delta = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 50) { goTo(delta > 0 ? current + 1 : current - 1); resetTimer(); }
  }, { passive: true });
</script>
