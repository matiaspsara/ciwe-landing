---
import { featuredFlavors, lineaHunno, lineaZero } from '../data/flavors.js';
---

<section id="helados" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Section header -->
    <div data-animate class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-green mb-3">Temporada 2025 / 26</p>
      <h2 class="font-heading text-5xl md:text-6xl text-brand-green-dark">Nuestros Sabores</h2>
      <div class="mt-4 w-16 h-0.5 bg-brand-green mx-auto"></div>
    </div>

    <!-- Featured flavor photo grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {featuredFlavors.map((flavor, i) => (
        <article
          data-animate
          style={`--delay: ${i * 60}ms`}
          class="group rounded-2xl overflow-hidden border border-brand-cream-dark bg-brand-cream flex flex-col shadow-sm"
        >
          <!-- Photo -->
          <div class="relative overflow-hidden aspect-[3/4]">
            <img
              src={flavor.photo}
              alt={flavor.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            {flavor.isNew && (
              <span class="absolute top-3 left-3 bg-brand-beige text-brand-green-dark text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full">
                Nuevo
              </span>
            )}
            <span class="absolute bottom-3 left-3 bg-black/30 backdrop-blur-sm text-white text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full">
              {flavor.category}
            </span>
          </div>
          <!-- Info -->
          <div class="p-4 flex flex-col gap-1 flex-1">
            <h3 class="font-heading text-base leading-snug text-brand-green-dark">
              {flavor.name}
            </h3>
            <p class="text-xs text-brand-taupe leading-relaxed">
              {flavor.description}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA to full flavor list -->
    <div data-animate class="text-center mt-10">
      <a
        href="/sabores"
        class="inline-flex items-center gap-2 px-7 py-3.5 border-2 border-brand-green text-brand-green font-heading font-bold text-sm uppercase tracking-wider rounded-full hover:bg-brand-green hover:text-white transition-colors"
      >
        Ver todos los sabores
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Product types — editorial photo grids -->
    <div class="mt-20 flex flex-col gap-4">
      <p data-animate class="text-xs font-bold uppercase tracking-[0.25em] text-brand-taupe text-center mb-4">También disfrutá de</p>

      <!-- Tortas Heladas: large left + two stacked right -->
      <div data-animate class="grid grid-cols-1 md:grid-cols-3 gap-4 md:h-[520px]">

        <!-- Main photo -->
        <div class="group relative rounded-2xl overflow-hidden aspect-[4/3] md:aspect-auto md:col-span-2">
          <img
            src="/photos/Torta-Helada-Almendrado-Dos-Bandejas.webp"
            alt="Tortas Heladas Ciwe"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-7">
            <h3 class="font-heading text-3xl md:text-4xl text-white leading-tight mb-2">Tortas Heladas</h3>
            <p class="text-white/70 text-sm leading-relaxed">Creaciones únicas para celebrar cada momento especial.</p>
          </div>
        </div>

        <!-- Two stacked photos -->
        <div class="hidden md:grid grid-rows-2 gap-4">
          <div class="group relative rounded-2xl overflow-hidden">
            <img
              src="/photos/Torta-Helada-Chocolate-Closeup.webp"
              alt="Torta helada de chocolate"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="group relative rounded-2xl overflow-hidden">
            <img
              src="/photos/Torta-Helada-Crema-Merengues-Vista-Aerea.webp"
              alt="Torta helada de crema y merengues"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
        </div>

      </div>

      <!-- Paletas: two side by side -->
      <div data-animate style="--delay: 100ms" class="grid grid-cols-2 gap-4 md:h-[380px]">

        <div class="group relative rounded-2xl overflow-hidden aspect-[4/3] md:aspect-auto">
          <img
            src="/photos/Paletas-Personajes-Spiderman-Peppa-Minion.webp"
            alt="Paletas personalizadas Ciwe"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="font-heading text-2xl md:text-3xl text-white leading-tight mb-1">Paletas</h3>
            <p class="text-white/70 text-sm leading-relaxed hidden md:block">Paletas artesanales en los sabores que más querés.</p>
          </div>
        </div>

        <div class="group relative rounded-2xl overflow-hidden aspect-[4/3] md:aspect-auto">
          <img
            src="/photos/Paleta-Spiderman-En-Mano.webp"
            alt="Paleta artesanal Ciwe"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>

      </div>

    </div>

    <!-- Special lines -->
    <div class="mt-24 border-t border-brand-cream-dark pt-16 grid grid-cols-1 md:grid-cols-2 gap-12">
      {[lineaHunno, lineaZero].map((line, i) => (
        <div data-animate style={`--delay: ${i * 120}ms`}>
          <div class="flex items-center gap-3 mb-4">
            <span
              class="text-xs font-black uppercase tracking-widest px-3 py-1.5 rounded-full border-2"
              style={`color: ${i === 0 ? '#1B6B3A' : '#2A4A6A'}; border-color: ${i === 0 ? '#1B6B3A' : '#2A4A6A'};`}
            >
              {line.badge}
            </span>
          </div>
          <h3 class="font-heading text-3xl text-brand-green-dark mb-3">{line.label}</h3>
          <p class="text-sm text-brand-taupe leading-relaxed mb-6 max-w-sm">{line.description}</p>
          <p class="text-sm text-brand-green-dark leading-relaxed">
            {line.items.join(' · ')}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
