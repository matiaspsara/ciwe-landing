---
const socials = [
  { label: 'Instagram', href: '#', handle: '@ciwe_helados' },
  { label: 'Facebook', href: '#', handle: 'Ciwe Heladería' },
  { label: 'WhatsApp', href: '#', handle: '+54 [número]' },
];
---

<section id="contacto" class="bg-brand-green text-brand-cream">
  <div class="max-w-7xl mx-auto px-6 py-24">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-beige/80 mb-3">Estamos para vos</p>
      <h2 class="font-heading text-5xl md:text-6xl text-white">Contacto</h2>
      <div class="mt-4 w-16 h-0.5 bg-white/30 mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-20">

      <!-- Dirección -->
      <div class="flex flex-col gap-4">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="font-heading text-xl font-semibold">Dónde encontrarnos</h3>
        <p class="text-brand-cream/70 text-sm leading-relaxed">
          [Dirección completa]<br />
          [Ciudad, Provincia]
        </p>
      </div>

      <!-- Horarios -->
      <div class="flex flex-col gap-4">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-heading text-xl font-semibold">Horarios</h3>
        <div class="text-brand-cream/70 text-sm leading-relaxed flex flex-col gap-1">
          <span>Lunes a Viernes: [horario]</span>
          <span>Sábados: [horario]</span>
          <span>Domingos: [horario]</span>
        </div>
      </div>

      <!-- Redes sociales -->
      <div class="flex flex-col gap-4">
        <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
        </div>
        <h3 class="font-heading text-xl font-semibold">Seguinos</h3>
        <div class="flex flex-col gap-2">
          {socials.map(s => (
            <a
              href={s.href}
              class="text-sm text-brand-cream/70 hover:text-white transition-colors"
            >
              <span class="font-semibold text-brand-cream/50 text-xs uppercase tracking-wider">{s.label}</span>
              <br />{s.handle}
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Divider -->
    <div class="border-t border-white/15 pt-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <img src="/logo.png" alt="Ciwe" class="h-8 brightness-0 invert opacity-80" />
      <p class="text-brand-cream/40 text-xs text-center">
        © {new Date().getFullYear()} Ciwe · Heladería Artesanal · Desde 1979
      </p>
      <p class="text-brand-cream/30 text-xs">
        Hecho con 🍦 en la región
      </p>
    </div>

  </div>
</section>
