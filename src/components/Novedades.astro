---
---

<section id="novedades" class="py-24 bg-white">
  <div class="max-w-5xl mx-auto px-6">

    <!-- Header -->
    <div data-animate class="text-center mb-14">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-green mb-3">Seguinos</p>
      <h2 class="font-heading text-5xl md:text-6xl text-brand-green-dark">Novedades</h2>
      <div class="mt-4 w-16 h-0.5 bg-brand-green mx-auto"></div>
      <p class="mt-6 text-brand-taupe max-w-md mx-auto leading-relaxed">
        Nuevos sabores, temporadas especiales y todo lo que pasa en Ciwe — directo desde nuestro Instagram.
      </p>
    </div>

    <!-- Instagram feed -->
    <div data-animate>
      <behold-widget feed-id="42wp4ViFu5uGBMxD4MQk"></behold-widget>
      <script>
        (() => {
          const d = document, s = d.createElement("script");
          s.type = "module";
          s.src = "https://w.behold.so/widget.js";
          d.head.append(s);
        })();
      </script>
    </div>

    <!-- Follow button -->
    <div data-animate class="mt-10 flex justify-center">
      <a
        href="https://instagram.com/heladeriaciwe"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 border-2 border-brand-green text-brand-green font-heading text-sm uppercase tracking-widest px-7 py-3 rounded-full hover:bg-brand-green hover:text-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/>
          <circle cx="12" cy="12" r="4" stroke-width="2"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
        </svg>
        @heladeriaciwe
      </a>
    </div>

  </div>
</section>
